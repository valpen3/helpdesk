# Скопируйте в .env и замените значения. Файл .env в git не попадает.

# --- Общие ---
LOG_LEVEL=INFO

# --- PostgreSQL (суперпользователь кластера и пользователи сервисов) ---
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth-db
TICKETS_DB_PASSWORD=change-me-tickets-db
SLA_DB_PASSWORD=change-me-sla-db

# --- Redis (ACL-пользователи) ---
AUTH_REDIS_PASSWORD=change-me-auth-redis
TICKET_REDIS_PASSWORD=change-me-ticket-redis
NOTIF_REDIS_PASSWORD=change-me-notif-redis
EXPORTER_REDIS_PASSWORD=change-me-exporter-redis

# --- RabbitMQ ---
RABBITMQ_ADMIN_PASSWORD=change-me-rabbit-admin
TICKET_MQ_PASSWORD=change-me-ticket-mq
NOTIF_MQ_PASSWORD=change-me-notif-mq
SLA_MQ_PASSWORD=change-me-sla-mq

# --- auth-service ---
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=change-me-admin
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- notification-service ---
ONCALL_EMAIL=oncall@helpdesk.local
ADMIN_NOTIFY_EMAIL=admin@helpdesk.local

# --- sla-service ---
SLA_TIME_SCALE=1
SLA_CHECK_INTERVAL=30
