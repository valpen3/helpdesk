# Скопируйте в .env и замените значения. Файл .env в git не попадает.

# --- Общие ---
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_TIMEOUT=0.25

# --- PostgreSQL (суперпользователь кластера и пользователи сервисов) ---
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth-db
TICKETS_DB_PASSWORD=change-me-tickets-db
SLA_DB_PASSWORD=change-me-sla-db

# --- Redis (ACL-пользователи) ---
AUTH_REDIS_PASSWORD=change-me-auth-redis
TICKET_REDIS_PASSWORD=change-me-ticket-redis
NOTIF_REDIS_PASSWORD=change-me-notif-redis
EXPORTER_REDIS_PASSWORD=change-me-exporter-redis

# --- RabbitMQ ---
RABBITMQ_ADMIN_PASSWORD=change-me-rabbit-admin
TICKET_MQ_PASSWORD=change-me-ticket-mq
NOTIF_MQ_PASSWORD=change-me-notif-mq
SLA_MQ_PASSWORD=change-me-sla-mq
MQ_TIMEOUT=5

# --- auth-service ---
# Create local RS256 keys with: bash scripts/gen_keys.sh
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- notification-service ---
MAIL_FROM=helpdesk@example.com
ONCALL_EMAIL=oncall@example.com
ADMIN_NOTIFY_EMAIL=admin@example.com
NOTIF_RETRY_DELAY_MS=30000
NOTIF_MAX_ATTEMPTS=3
NOTIF_IDEMPOTENCY_TTL=604800
NOTIF_IDEMPOTENCY_LOCK_TTL=300

# --- sla-service ---
SLA_TIME_SCALE=1
SLA_CHECK_INTERVAL=30

# --- HA and monitoring ---
REDIS_REPLICATION_PASSWORD=change-me-replication
REDIS_SENTINEL_PASSWORD=change-me-sentinel
RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie
GRAFANA_ADMIN_PASSWORD=change-me-grafana
EXPORTER_DB_PASSWORD=change-me-metrics-db
